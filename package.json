{
  "name": "odysseus",
  "productName": "Odysseus",
  "version": "0.1.1",
  "description": "A fast Git client with first-class Git hook support",
  "main": "./out/main/index.js",
  "author": "Odysseus",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "esbuild scripts/smoke-test.ts --bundle --platform=node --format=esm --outfile=out/smoke-test.mjs --alias:@shared=./src/shared --log-level=warning && node out/smoke-test.mjs",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.odysseus.git",
    "productName": "Odysseus",
    "icon": "resources/icon.png",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development"
    },
    "portable": {
      "artifactName": "Odysseus-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
